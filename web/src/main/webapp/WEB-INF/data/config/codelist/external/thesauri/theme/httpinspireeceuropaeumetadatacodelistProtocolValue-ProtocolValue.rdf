<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <skos:ConceptScheme xmlns:skos="http://www.w3.org/2004/02/skos/core#" rdf:about="http://inspire.ec.europa.eu/metadata-codelist/ProtocolValue">
    <dc:title xmlns:dc="http://purl.org/dc/elements/1.1/" xml:lang="en">INSPIRE Protocol values</dc:title>
    <dc:title xmlns:dc="http://purl.org/dc/elements/1.1/" xml:lang="it">INSPIRE Protocol values</dc:title>
    <dc:description xmlns:dc="http://purl.org/dc/elements/1.1/" xml:lang="en">Set of OGC and RFC services that are in the scope of INSPIRE. This list aims at the better identification of the network services described within the metadata records. THIS IS NOT THE ORIGINAL INSPIRE FILE. Labels have modified according to RNDT XSL conversion file. Download and link items have been added.</dc:description>
    <dc:description xmlns:dc="http://purl.org/dc/elements/1.1/" xml:lang="it">Set of OGC and RFC services that are in the scope of INSPIRE. This list aims at the better identification of the network services described within the metadata records. THIS IS NOT THE ORIGINAL INSPIRE FILE. Labels have modified according to RNDT XSL conversion file. Download and link items have been added.</dc:description>
    <dcterms:issued xmlns:dcterms="http://purl.org/dc/terms/">2020-11-02T20:02:41</dcterms:issued>
    <dcterms:modified xmlns:dcterms="http://purl.org/dc/terms/">2020-11-02T20:02:41</dcterms:modified>
  </skos:ConceptScheme>
